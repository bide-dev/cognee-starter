  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DataProcessingServicer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider"/>
    <rdfs:subClassOf rdf:nodeID="N8d0084573489484189e9da67ef554184"/>
    <rdfs:label>data processing servicer</rdfs:label>
    <skos:definition>finance services provider primarily engaged in providing infrastructure for hosting or data processing services</skos:definition>
    <cmns-av:adaptedFrom>https://www.ffiec.gov/npw/Help/InstitutionTypes</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>These establishments may provide specialized hosting activities, such as web hosting, streaming services or application hosting, provide application service provisioning, or may provide general time-share mainframe facilities to clients. Data processing establishments provide complete processing and specialized reports from data supplied by clients or provide automated data processing and data entry services.</cmns-av:explanatoryNote>
  </rdf:Description>
