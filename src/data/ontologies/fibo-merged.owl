  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/StepUpBond">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/Bond"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/FixedIncomeSecurity"/>
    <rdfs:subClassOf rdf:nodeID="N6666d30145ce433d9cab857947f9049d"/>
    <rdfs:label>step up bond</rdfs:label>
    <skos:definition>bond with a coupon that increases (steps up) while the bond is outstanding</skos:definition>
    <cmns-av:explanatoryNote>The step change may be one time, or occur according to a schedule or at regular intervals.</cmns-av:explanatoryNote>
    <cmns-av:synonym>step down bond</cmns-av:synonym>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-LinearAmortizer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
    <rdf:type rdf:nodeID="N47dc2880723842d5aefd2b8b6974985a"/>
    <rdfs:label>ACTUS contract type - linear amortizer</rdfs:label>
    <dcterms:source>https://www.actusfrf.org/taxonomy</dcterms:source>
    <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and where the principal is repaid in equal amounts until maturity, with interest payments decreasing accordingly</skos:definition>
    <skos:note>Interest payments decrease over time as the outstanding principal reduces.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>Standard amortizing loans with fixed principal repayments.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>LAM</cmns-txt:hasTextValue>
  </rdf:Description>
