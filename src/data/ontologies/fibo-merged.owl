    <cmns-rga:isJurisdictionOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/EasternAsiaGovernmentEntitiesAndJurisdictions/GovernmentOfJapan"/>
  </rdf:Description>
