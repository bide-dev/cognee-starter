  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-ConvertibleNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
