  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Assessments Ontology</rdfs:label>
    <dcterms:abstract>This ontology defines abstract concepts for assessments, evaluations, and outcomes, as the basis for various analysis, such as for business performance, compliance and risk.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2019-2025 EDM Council, Inc.
