    <owl:disjointWith rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnemploymentRate"/>
    <skos:definition>economic indicator representing measure of the change over time in the prices of consumer goods and services that households consume</skos:definition>
    <cmns-av:abbreviation>CPI</cmns-av:abbreviation>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf</cmns-av:adaptedFrom>
