  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>ISO 4217-1 Currency Codes Ontology</rdfs:label>
    <dcterms:abstract>This ontology represents the subset of the ISO 4217 standard that include the actual currency codes.</dcterms:abstract>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-01T00:00:00</dcterms:issued>
