  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LiabilityCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity"/>
    <rdfs:label xml:lang="en">liability capacity</rdfs:label>
    <skos:definition>the ability to be sued at law</skos:definition>
    <skos:editorialNote>Note that for the purposes of this model, this is distinct from culpability (the ability to commit criminal acts). That would be a separate and analogous term but with grounding in criminal rather than civil law.</skos:editorialNote>
  </rdf:Description>
