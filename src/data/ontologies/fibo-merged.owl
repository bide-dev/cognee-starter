  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NovationNettingProvision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision"/>
    <rdfs:label xml:lang="en">novation netting provision</rdfs:label>
    <skos:definition xml:lang="en">contractual element that specifies what should be done with respect to netting when a given contract is replaced with another</skos:definition>
    <cmns-av:explanatoryNote>Novation netting contemplates that for each value date and for each currency, the parties agree that all existing contracts will be canceled (discharged and extinguished) and simultaneously replaced by a new contract that aggregates and nets all of the payment obligations of the original contracts. Novation netting occurs immediately when a nettable transaction is entered into.</cmns-av:explanatoryNote>
  </rdf:Description>
