  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-CreditDefaultSwap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
    <rdf:type rdf:nodeID="N40d6915633244611b50fb4e1117479ff"/>
    <rdfs:label>ACTUS contract type - credit default swap</rdfs:label>
    <skos:definition>cashflow classifier that applies to contracts for which a payment is triggered if one or more of the underlying counterparties defaults</skos:definition>
    <skos:editorialNote>Is this really limited to CDS, or should it apply to anything (or maybe any derivative) where one of the parties to an underlying contract that triggers payment defaults?</skos:editorialNote>
    <fibo-actus-acv:hasCoverageDescription>All sorts of credit default swaps.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>CDSWP</cmns-txt:hasTextValue>
  </rdf:Description>
