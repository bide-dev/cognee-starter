  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CommoditiesContracts/CommodityFuture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CommoditiesContracts/CommodityDerivative"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future"/>
    <rdfs:label xml:lang="en">commodity future</rdfs:label>
    <owl:disjointWith rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/FuturesAndForwards/FinancialFuture"/>
    <skos:definition xml:lang="en">futures contract to buy or sell a predetermined amount of a commodity at a specific price on a specific date in the future</skos:definition>
    <cmns-av:adaptedFrom xml:lang="en">CFTC glossary</cmns-av:adaptedFrom>
    <cmns-av:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019-10</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote xml:lang="en">A commodity future is an agreement to purchase or sell a commodity for delivery in the future: (1) at a price that is determined at initiation of the contract; (2) that obligates each party to the contract to fulfill the contract at the specified price; (3) that is used to assume or shift price risk; and (4) that may be satisfied by delivery or offset.</cmns-av:explanatoryNote>
  </rdf:Description>
