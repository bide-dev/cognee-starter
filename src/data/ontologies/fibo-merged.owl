  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/LoanProducts/LoanPurpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
