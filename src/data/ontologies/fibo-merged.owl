  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/ContingentCreditDefaultSwap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/CreditDefaultSwap"/>
    <rdfs:label xml:lang="en">contingent credit default swap</rdfs:label>
    <skos:definition xml:lang="en">credit default swap in which an additional triggering event is required</skos:definition>
    <cmns-av:abbreviation xml:lang="en">CCDS</cmns-av:abbreviation>
    <cmns-av:explanatoryNote xml:lang="en">In a contingent credit default swap, the trigger requires both a credit event (as in a traditional credit default swap) and another specified event. The additional specified event is usually a significant movement in an index covering equities, commodities, interest rates, or some other overall measure of the economy or relevant industry.</cmns-av:explanatoryNote>
  </rdf:Description>
