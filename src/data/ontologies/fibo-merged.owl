    <cmns-av:adaptedFrom>National Futures Association</cmns-av:adaptedFrom>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CombinedStatisticalArea">
