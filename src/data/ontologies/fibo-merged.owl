  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/Facility-NCEL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OperatingLevelMarket"/>
    <rdfs:label>PAKISTAN MERCANTILE EXCHANGE</rdfs:label>
    <skos:note>REGISTERED FOR LISTED DERIVATIVES (OPTIONS AND FUTURES) TRADING - FORMERLY NATIONAL COMMODITY EXCHANGE LIMITED.</skos:note>
    <fibo-fbc-fct-mkt:hasFacilityAcronym>PMEX</fibo-fbc-fct-mkt:hasFacilityAcronym>
