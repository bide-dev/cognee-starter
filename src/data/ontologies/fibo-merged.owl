  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CurrencyContracts/CurrencySwap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CurrencyContracts/CurrencyDerivative"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/Swap"/>
    <rdfs:subClassOf rdf:nodeID="N1a6e465c41964a98b829e7b16bd09f29"/>
    <rdfs:label xml:lang="en">currency swap</rdfs:label>
    <skos:definition xml:lang="en">foreign exchange agreement between two parties to exchange a given amount of one currency for another currency for spot delivery or for forward delivery at an agreed rate after a specified period of time</skos:definition>
    <skos:note xml:lang="en">In the case of a 'forward-forward' swap, both legs will be of type CurrencyFoward.</skos:note>
    <cmns-av:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15</cmns-av:adaptedFrom>
  </rdf:Description>
