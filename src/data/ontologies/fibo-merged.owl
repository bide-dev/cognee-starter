    <rdf:type rdf:nodeID="N53670f034cc14dcd9fddda0397c3827b"/>
    <rdfs:label>ACTUS contract type - exotic option</rdfs:label>
    <skos:definition>cashflow classifier that applies to exotic options</skos:definition>
    <skos:note>As of current, most of the exotic options which were popular before 2008 are out of favor and factually irrelevant. Which of the exotic options will be implemented will depend on the real relevance in the future.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>Knock-in and Knock-out, Barrier, Ladder, Rainbow options etc.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>EXOTi</cmns-txt:hasTextValue>
  </rdf:Description>
