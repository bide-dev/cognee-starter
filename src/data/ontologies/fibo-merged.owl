  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/StrikePrice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice"/>
    <rdfs:label xml:lang="en">strike price</rdfs:label>
    <skos:definition xml:lang="en">price at which a lot of the underlying asset may be bought or sold when the contract is exercised</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">For call options, the strike price is the price at which the security may be purchased by the option holder; for put options, the strike price is the price at which the security may be sold.</cmns-av:explanatoryNote>
  </rdf:Description>
