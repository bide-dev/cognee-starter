  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/Classifiers/Classifier"/>
    <rdfs:subClassOf rdf:nodeID="N03ffdce0ba774584a31bdfa1fb312669"/>
    <rdfs:subClassOf rdf:nodeID="N034286b3f3404f739383eb0a54a325d9"/>
    <rdfs:label>rating score</rdfs:label>
    <skos:definition>grade, classification, or ranking of for something in accordance with some rating scale</skos:definition>
    <cmns-av:explanatoryNote>The meaning and methodology for determining a rating score for the rating of something is determined by a rating issuer. A given rating may apply at some point in time, as a part of a lifecycle or process, or generally. Typically ratings reflect an assessment of a state of affairs at some point in time.</cmns-av:explanatoryNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/MarketCapitalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression"/>
    <rdfs:subClassOf rdf:nodeID="N5259b7f0e2c744f59cf064b284686108"/>
    <rdfs:subClassOf rdf:nodeID="N59c7d120ec0b44788f47da55cdd4f676"/>
    <rdfs:subClassOf rdf:nodeID="N895a851022584046a5bf638a60e78f39"/>
    <rdfs:subClassOf rdf:nodeID="Nec653279233d49d2b297292a90eee8bc"/>
    <rdfs:subClassOf rdf:nodeID="Nf35622b0bf6b4fd8b9630bdd5090e681"/>
    <rdfs:label xml:lang="en">market capitalization</rdfs:label>
    <skos:definition xml:lang="en">expression representing the perceived value of a company as determined by the stock market at a specific point in time</skos:definition>
    <cmns-av:synonym xml:lang="en">market cap</cmns-av:synonym>
    <cmns-qtu:describesActualExpression xml:lang="en">number of shares outstanding x price per share</cmns-qtu:describesActualExpression>
  </rdf:Description>
