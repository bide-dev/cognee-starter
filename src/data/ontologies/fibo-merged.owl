  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/RiskPoolingInstitution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution"/>
    <rdfs:label>risk pooling institution</rdfs:label>
    <skos:definition>financial institution that provides some financial service while spreading the financial risk inherent in that service to lower the probability of a catastrophic financial event by aggregating customers across diverse dimensions as a risk management practice</skos:definition>
    <skos:example>Insurance companies are the most common form of risk pooling institution.</skos:example>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.worldbank.org/en/publication/gfdr/gfdr-2016/background/nonbank-financial-institution</cmns-av:adaptedFrom>
  </rdf:Description>
