  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/EscrowAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/RegisteredAgent"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty"/>
    <rdfs:subClassOf rdf:nodeID="N5a3c7faa004741fa947f550f13309af4"/>
    <rdfs:label xml:lang="en">escrow agent</rdfs:label>
    <skos:definition xml:lang="en">third party that holds an asset or funds before they are formally transferred from one party to another party, per the terms of a contract, within some specified time period and/or when a triggering event occurs</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Use of an escrow agent is one possible mechanism that may be used in some cases, as specified in a credit default swap contract, for delivery purposes.</cmns-av:explanatoryNote>
  </rdf:Description>
