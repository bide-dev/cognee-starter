  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/ReferenceIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
