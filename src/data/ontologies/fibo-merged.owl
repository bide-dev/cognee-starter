    <cmns-dsg:denotes rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/CaboVerdeEscudo"/>
    <cmns-id:identifies rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/CaboVerdeEscudo"/>
