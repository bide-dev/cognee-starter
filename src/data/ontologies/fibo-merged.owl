  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/OutputProducerPriceIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ProducerPriceIndex"/>
    <rdfs:label>output producer price index</rdfs:label>
    <skos:definition>economic indicator representing measure of the rate of change over time in the prices of products sold as they leave the producer</skos:definition>
