    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract"/>
    <rdfs:label xml:lang="en">indenture</rdfs:label>
    <skos:definition xml:lang="en">A written contract, also known as a "Deed of Trust", under which bonds and debentures are issued, setting forth maturity date, interest rate, redemption rights, call privileges and other terms. Under the rules of the Trust Indenture Act of 1939, the contract is executed by the issuer and a trustee who acts on behalf of the bondholders.</skos:definition>
  </rdf:Description>
