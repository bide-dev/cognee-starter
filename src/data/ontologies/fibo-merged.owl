  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/CommonInterestRates/NZD-Semi-Annual_Swap_Rate-BGCANTOR-Reference_Banks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
