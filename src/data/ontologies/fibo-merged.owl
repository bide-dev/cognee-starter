  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/Undertaking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nababe4fe07b546c6a1968ffa502d083b"/>
    <rdfs:subClassOf rdf:nodeID="Na0e231a1e5e64d41b13c9b44654af9cc"/>
    <rdfs:subClassOf rdf:nodeID="N9612a4252a0a4c14b0eb1f370f8a12de"/>
    <rdfs:subClassOf rdf:nodeID="N6c1096915a3246a49cdfe4598ac1ca6e"/>
