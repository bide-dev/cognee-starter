  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/ServiceProvider-L-984500BCC73F71C0D336">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
