    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/MarineFinance/"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/StudentLoans/"/>
