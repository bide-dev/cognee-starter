  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/MortgageBackedSecurities/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Mortgage-backed Securities Ontology</rdfs:label>
    <dcterms:abstract>Mortgage backed securities are like asset backed securities except that the underlying loan pool is a pool of mortgage loans.</dcterms:abstract>
