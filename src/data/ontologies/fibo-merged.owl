  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/EuropeanEntities/EuropeanFinancialServicesEntitiesIndividuals/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>European Financial Services Entities Individuals Ontology</rdfs:label>
    <dcterms:abstract>This ontology extends the primary financial services entities ontology in FBC with individuals representing additional kinds of entities that provide services internationally, such as international market data providers, organizations that provide exchanges in multiple countries, etc.</dcterms:abstract>
