  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/SoleProprietorships/SoleProprietorships/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Sole Proprietorships Ontology</rdfs:label>
    <dcterms:abstract>This ontology defines the fundamental concepts for representing sole proprietorships -- i.e., organizations that are owned by an individual that is responsible for the liabilities of the organization.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2016-2025 EDM Council, Inc.
