  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/CreditEvents/hasGracePeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/hasDatePeriod"/>
    <rdfs:label xml:lang="en">has grace period</rdfs:label>
    <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod"/>
    <skos:definition xml:lang="en">window following any payment due date during which a party must fulfill its obligations before a failure to pay credit event occurs</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Note that this may be a period denominated in business days or calendar days.</cmns-av:explanatoryNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/DepositaryReceipts/AmericanDepositaryReceiptLevel">
