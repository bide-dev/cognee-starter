  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ProfitObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessObjective"/>
    <rdfs:label>profit objective</rdfs:label>
    <skos:definition>objective that reflects pursuit of a financial benefit that may be realized when the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity</skos:definition>
    <cmns-av:explanatoryNote>Any profit that is gained goes to the business's owners, who may or may not decide to spend it on the business.</cmns-av:explanatoryNote>
    <cmns-av:synonym>for profit objective</cmns-av:synonym>
    <cmns-av:synonym>profit motive</cmns-av:synonym>
  </rdf:Description>
