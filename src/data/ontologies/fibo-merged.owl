  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/CAGovernmentEntitiesAndJurisdictions/GovernmentOfCanada">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/FederalGovernment"/>
    <rdfs:label>Government of Canada</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/CAGovernmentEntitiesAndJurisdictions/"/>
    <rdfs:seeAlso rdf:resource="https://www.canada.ca/en/index.html"/>
    <skos:definition>individual representing the federal parliamentary democracy and constitutional monarchy of Canada</skos:definition>
    <cmns-av:explanatoryNote>Canada is a federal parliamentary democracy and a constitutional monarchy, with Queen Elizabeth II being the head of state. The country is officially bilingual at the federal level. It is one of the world's most ethnically diverse and multicultural nations, the product of large-scale immigration from many countries. Its advanced economy is the eleventh largest in the world, relying chiefly upon its abundant natural resources and well-developed international trade networks.</cmns-av:explanatoryNote>
    <cmns-rga:governs rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Canada"/>
    <cmns-rga:hasJurisdiction rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/CAGovernmentEntitiesAndJurisdictions/CanadianJurisdiction"/>
  </rdf:Description>
