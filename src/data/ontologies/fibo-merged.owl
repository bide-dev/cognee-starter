    <rdfs:label xml:lang="en">formal offer</rdfs:label>
    <owl:equivalentClass rdf:nodeID="N10a68897700e4be7b018d296562dbc9f"/>
    <skos:definition xml:lang="en">corporate action involving an offer to a holder, potential holder, or other intersted party, to enter into a trade which is or would be legally binding on the part of the party making the offer (the offeror).</skos:definition>
  </rdf:Description>
