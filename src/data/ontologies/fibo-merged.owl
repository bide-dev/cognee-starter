  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/RateDerivatives/IRSwaps/FloatFloatInterestRateSwap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/BasisSwap"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/RateDerivatives/IRSwaps/InterestRateSwap"/>
    <rdfs:subClassOf rdf:nodeID="N4cac6ed71a1a4f8f867f6a562d92287b"/>
    <rdfs:label>float float interest rate swap</rdfs:label>
    <owl:equivalentClass rdf:nodeID="N16d8f3072857484ca86193d4ff26640b"/>
    <skos:definition>interest rate swap that exchanges cashflows based on two different floating interest rates</skos:definition>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.investopedia.com/terms/b/basisrateswap.asp</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>This is a swap in which two parties swap variable interest rates based on different money markets, and this is usually done to limit interest-rate risk that a company faces as a result of having differing lending and borrowing rates.</cmns-av:explanatoryNote>
    <cmns-av:synonym>basis rate swap</cmns-av:synonym>
    <cmns-av:synonym>float-float interest rate swap</cmns-av:synonym>
  </rdf:Description>
