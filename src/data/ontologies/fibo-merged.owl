  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/CARegulatoryAgencies/CorporationIncomeTaxNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/CARegulatoryAgencies/BusinessNumber"/>
    <rdfs:subClassOf rdf:nodeID="N97b10bd1d9a046338d2adf10e9ad5bf9"/>
    <rdfs:subClassOf rdf:nodeID="N2a123a49fc39491f82dc317025f50739"/>
    <rdfs:subClassOf rdf:nodeID="N73e19973d0a14901a2c91686ba9fc8d6"/>
    <rdfs:label>corporation income tax number</rdfs:label>
    <skos:definition>concatenation of an entity's business number, the 'RC' abbreviation and a 4-digit subaccount number used for reporting corporate income tax</skos:definition>
    <skos:example>000000000RC0001</skos:example>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/registering-your-business/corporation-income-tax-program-account.html</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>An organization may have more than one tax account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration.</cmns-av:explanatoryNote>
  </rdf:Description>
