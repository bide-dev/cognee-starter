  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Annuity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
    <rdf:type rdf:nodeID="N9b13d415fd674a2bb7d4f7b4a4909be1"/>
    <rdfs:label>ACTUS contract type - annuity</rdfs:label>
    <dcterms:source>https://www.actusfrf.org/taxonomy</dcterms:source>
    <skos:definition>cashflow classifier that applies to contracts whose principal is paid fully at the initial exchange date and principal plus interest is repaid periodically in constant amounts until maturity</skos:definition>
    <skos:note>If the contract has a variable rate, the total amount of principal and interest is recalculated to be fully matured at the maturity date.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>classic level payment mortgages, leasing contracts, etc.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Basic"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-FixedIncome"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>ANN</cmns-txt:hasTextValue>
  </rdf:Description>
