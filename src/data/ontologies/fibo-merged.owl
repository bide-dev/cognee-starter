  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/SecuritiesTransactions/offsetForWIIssueDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">offset for w i issue date</rdfs:label>
    <rdfs:domain rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/SecuritiesTransactions/WhenIssuedTransaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">Used to calculate actual settlement date from given WI issue date. If issue date is unknwn, this determines how many days form the issue date it's going to settle.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-Swap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
    <rdf:type rdf:nodeID="Nc9a92501383e4bb38684b3e07cbac410"/>
    <rdfs:label>ACTUS contract type - swap</rdfs:label>
    <dcterms:source>https://www.actusfrf.org/taxonomy</dcterms:source>
    <skos:definition>cashflow classifier that applies to derivative contracts where two parties exchange contracts</skos:definition>
    <skos:note>Normally one leg is fixed, the other variable. However all variants possible including different currencies for cross currency swaps, basic swaps or even different principal exchange programs.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>All kind of swaps. The variety is defined by the underlying CT's which often are PAM and ANN in all its flavors. With each new basic CT the variety rises.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Symmetric"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>SWAPS</cmns-txt:hasTextValue>
  </rdf:Description>
