  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/CreditEventNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/Documents/Notice"/>
    <rdfs:subClassOf rdf:nodeID="N047ff434972e47e08e955c5f441828af"/>
    <rdfs:subClassOf rdf:nodeID="N902a85783317430a94b3dc8379aa4e3d"/>
    <rdfs:label xml:lang="en">credit event notice</rdfs:label>
    <skos:definition xml:lang="en">irrevocable written or verbal notice that states that a triggering event has occurred</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Notices of certain kinds of credit events are required as a condition of a credit default swap. Such notices are sent from a notifying party (either the buyer or the seller) to the counterparty. They provide information that assists the contract parties in determining whether a triggering credit event has occurred.</cmns-av:explanatoryNote>
  </rdf:Description>
