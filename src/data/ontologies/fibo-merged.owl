  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/StructuredInstruments/CapitalProtectionCertificateWithParticipation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/StructuredInstruments/CapitalProtectedProduct"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/StructuredInstruments/ParticipationCertificate"/>
    <rdfs:label xml:lang="en">capital protection certificate with participation</rdfs:label>
    <skos:definition xml:lang="en">capital-protected product whose protection is defined as a percentage of the nominal amount (e.g. 100 percent), with minimum redemption at expiry equivalent to the capital protection</skos:definition>
    <skos:note xml:lang="en">Note that capital protection in this case refers to the nominal amount only, and not to the purchase price. The value of the product may fall below its capital protection value during its lifetime, and participation is in the underlying price increase above the strike.</skos:note>
    <cmns-av:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15, clause 6.4.7</cmns-av:adaptedFrom>
  </rdf:Description>
