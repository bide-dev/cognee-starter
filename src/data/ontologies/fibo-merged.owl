  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Variance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion"/>
    <rdfs:subClassOf rdf:nodeID="N992ec80bd41c462f8d6590e4e0b19749"/>
    <rdfs:label>variance</rdfs:label>
    <skos:definition>measure of spread, calculated as the average squared deviation of each number from the mean of a data set</skos:definition>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.statcan.gc.ca/edu/power-pouvoir/glossary-glossaire/5214842-eng.htm#v</cmns-av:adaptedFrom>
    <cmns-av:symbol>μ2</cmns-av:symbol>
    <cmns-av:symbol>σ2</cmns-av:symbol>
    <cmns-av:synonym>second moment</cmns-av:synonym>
  </rdf:Description>
