    <rdfs:label xml:lang="en">simple return leg</rdfs:label>
    <skos:definition xml:lang="en">return leg based strictly on the income generated by the underlying asset, excluding appreciation, decrease in value, capital gains, and fees on any increase in value</skos:definition>
