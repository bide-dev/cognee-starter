  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MetadataFBCFunctionalEntities/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Metadata about the EDMC-FIBO Financial Business and Commerce(FBC) Functional Entities Module</rdfs:label>
    <dcterms:abstract>The functional entities module includes ontologies that define business entities according to their function as opposed to their form. They include service providers such as financial institutions (e.g., banks, investment companies, and insurance companies), government regulatory and registration agencies, as well as entities described in terms of their function in some process, such as clearing houses.</dcterms:abstract>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-08-13T18:00:00</dcterms:issued>
    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://opensource.org/licenses/MIT</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-03-31T18:00:00</dcterms:modified>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/"/>
    <owl:imports rdf:resource="https://www.omg.org/spec/Commons/AnnotationVocabulary/"/>
    <owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/20230301/FunctionalEntities/MetadataFBCFunctionalEntities/"/>
    <cmns-av:copyright>Copyright (c) 2015-2023 EDM Council, Inc.</cmns-av:copyright>
    <cmns-av:copyright>Copyright (c) 2015-2023 Object Management Group, Inc.</cmns-av:copyright>
  </rdf:Description>
