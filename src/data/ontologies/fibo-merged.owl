  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType-BoundaryControlledSwitch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSContractType"/>
    <rdf:type rdf:nodeID="N568f274940ce4ad781536b38dba50079"/>
    <rdfs:label>ACTUS contract type - boundary controlled switch</rdfs:label>
    <dcterms:source>https://www.actusfrf.org/taxonomy</dcterms:source>
    <skos:definition>cashflow classifier that applies to derivative contracts with subcontract legs which can be activated (knocked in) or extinguished (knocked out) when the underlying asset price reaches a specified value</skos:definition>
    <skos:editorialNote>Need to figure out what restrictions are needed on derivative instrument to limit the coverage to the right set of agreements, and then map to those.</skos:editorialNote>
    <skos:note>The underlying asset may be a stock, index, or exchange-traded fund. Boundary controlled switch contracts with a single boundary are currently defined.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>Knock-in and Knock-out barrier options with a single boundary. Bonus contracts with payout when underlying asset price remains above or below a specified level for specified period.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>BCS</cmns-txt:hasTextValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/MIC-CLMX">
