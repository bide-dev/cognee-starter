  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Ownership Ontology</rdfs:label>
    <dcterms:abstract>This ontology defines high-level, ownership-related concepts, including owner, asset and ownership along with relationships between them.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2013-2025 EDM Council, Inc.
