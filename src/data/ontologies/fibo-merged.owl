  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/DebtIssuance/hasOriginalIssueDiscount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has original issue discount</rdfs:label>
    <rdfs:domain rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/DebtIssuance/BondOffering"/>
    <rdfs:range rdf:resource="https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage"/>
    <skos:definition xml:lang="en">discount from par value at the time a bond or other debt instrument is issued</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">The OID is the difference between the stated redemption price at maturity and the actual issue price.</cmns-av:explanatoryNote>
  </rdf:Description>
