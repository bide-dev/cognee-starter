    <fibo-fbc-fct-mkt:operatesInMunicipality rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessCentersIndividuals/Boston"/>
    <fibo-fnd-rel-rel:hasFormalName>E-EXCHANGE</fibo-fnd-rel-rel:hasFormalName>
    <cmns-org:isManagedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/ServiceProvider-E-EXCHANGE"/>
