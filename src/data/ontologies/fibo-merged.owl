  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/NorthAmericanSecurities/USSecuritiesRestrictions/isFederalDepositInsuranceCorporationInsured">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>is Federal Deposit Insurance Corporation insured</rdfs:label>
    <rdfs:domain rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/NonTransactionDepositAccount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:seeAlso rdf:resource="https://www.fdic.gov/resources/deposit-insurance/"/>
    <skos:definition>indicates whether the security is covered by Federal Deposit Insurance Corporation (FDIC) insurance</skos:definition>
    <cmns-av:explanatoryNote>FDIC coverage extends to Certificates of Deposit (CDs) and Money Market Accounts (MMAs) held at FDIC-insured institutions up to $250,000 per account.</cmns-av:explanatoryNote>
    <cmns-av:usageNote>Note that this property applies to the account rather than to the associated instrument that, if it exists, exemplifies the account.</cmns-av:usageNote>
  </rdf:Description>
