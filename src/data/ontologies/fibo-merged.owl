  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/IronCondor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/CondorSpread"/>
    <rdfs:subClassOf rdf:nodeID="Nfc1f5085739144ac90c1751ff98845cd"/>
    <rdfs:subClassOf rdf:nodeID="Nd5f92f84111845a6906588f638abe87e"/>
    <rdfs:subClassOf rdf:nodeID="N87f2ddb5603f436d87611e68e01cedd5"/>
    <rdfs:label xml:lang="en">iron condor</rdfs:label>
    <skos:definition xml:lang="en">condor strategy consisting of two puts (one long and one short) and two calls (one long and one short), and four strike prices, all with the same expiration date</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">The iron condor earns the maximum profit when the underlying asset closes between the middle strike prices at expiration. In other words, the goal is to profit from low volatility in the underlying asset.</cmns-av:explanatoryNote>
  </rdf:Description>
