  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/SamplingVariance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Variance"/>
    <rdfs:label>sampling variance</rdfs:label>
    <skos:definition>measure of the extent to which the estimate of a characteristic from different possible samples of the same size and the same design differ from one another</skos:definition>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.statcan.gc.ca/pub/12-587-x/12-587-x2003001-eng.pdf</cmns-av:adaptedFrom>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://stats.oecd.org/glossary/detail.asp?ID=3834</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>The word 'sampling' can usually be omitted, as being defined by the context or otherwise understood. The sampling variance of a statistic is the square of its standard error.</cmns-av:explanatoryNote>
  </rdf:Description>
