  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/PrivateLabelMBSIssuance/TranchedOfferingMemorandum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/OfferingDocument"/>
    <rdfs:subClassOf rdf:nodeID="N4e6142567ab744b79d7d256deb02b727"/>
    <rdfs:subClassOf rdf:nodeID="N690a36307c81452f9a2633c216dbbf64"/>
    <rdfs:subClassOf rdf:nodeID="Na5354c06ebcb4702947553acb16f5e90"/>
    <rdfs:label xml:lang="en">tranched offering memorandum</rdfs:label>
    <skos:definition xml:lang="en">The Offering Memorandum will include or attach the terms for two or more individual tranches that will make up the issue, and the structure of the tranches, including how they will relate to one another (priorities and so on). Term origin:MBS PoC Reviews</skos:definition>
    <skos:definition xml:lang="en">The offering memorandum for a tranched MBS issue, setting out basic information about a future issue, for the information of prospective investors and their agents.</skos:definition>
  </rdf:Description>
