    <dcterms:title>FIBO BE Sole Proprietorships Module</dcterms:title>
    <dcterms:title>Financial Industry Business Ontology (FIBO) Business Entities (BE) Sole Proprietorships Module</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://spec.edmcouncil.org/fibo/"/>
