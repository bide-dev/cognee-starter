  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/StateOfUtahEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/RegionalSovereignty"/>
    <rdfs:label>State of Utah entity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/"/>
    <rdfs:seeAlso rdf:resource="http://www.utah.gov/index.html"/>
    <skos:definition>individual representing the regional sovereignty and polity that is the US State of Utah</skos:definition>
    <fibo-be-ge-ge:hasSharedSovereigntyOver rdf:resource="https://www.omg.org/spec/LCC/Countries/Regions/ISO3166-2-SubdivisionCodes-US/Utah"/>
