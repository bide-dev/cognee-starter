    <owl:inverseOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/hasControllingParty"/>
    <skos:definition>indicates something controlled that a controlling party has some amount of authority or influence over</skos:definition>
  </rdf:Description>
