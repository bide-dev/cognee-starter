  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/CommonInterestRates/EUR-6M_EURIBOR_SWAP-CME_vs_LCH-ICAP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
