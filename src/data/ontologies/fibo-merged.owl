  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/SettlementConvention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/Convention"/>
    <rdfs:subClassOf rdf:nodeID="Nc1cfa7917aa444239a4ee4de8e3fdca6"/>
    <rdfs:label>settlement convention</rdfs:label>
    <skos:definition>convention employed to determine the closing date (from the stated settlement date) in the process of settling a transaction on which securities or interests in securities are delivered, usually against (in simultaneous exchange for) payment of some consideration</skos:definition>
    <cmns-av:explanatoryNote>This is often stated in the form 'T+n' where n is the number of business days from the specified settlement date (T).</cmns-av:explanatoryNote>
  </rdf:Description>
