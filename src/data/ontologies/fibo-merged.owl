  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/EquityIndexExampleIndividuals/DowJonesIndustrialAverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/EquityIndex"/>
    <rdfs:label>Dow Jones Industrial Average</rdfs:label>
    <skos:definition>equity index of 30 substantial stocks that are traded on the New York Stock Exchange (NYSE) and the Nasdaq</skos:definition>
    <fibo-be-fct-pub:hasPublisher rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/EquityIndexExampleIndividuals/SPDowJonesIndices"/>
    <fibo-fbc-dae-dbt:isBasedOn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/EquityIndexExampleIndividuals/DowJonesIndustrialAverageBasket"/>
    <fibo-fnd-utl-alx:isCalculatedViaMethodology xml:lang="en">The index is calculated by adding the price of a single share of each stock together, with equal weighting, and dividing by the Dow Divisor which is constantly adjusted, and is currently around 0.1474.</fibo-fnd-utl-alx:isCalculatedViaMethodology>
    <cmns-av:abbreviation>DJIA</cmns-av:abbreviation>
    <cmns-av:abbreviation>Dow</cmns-av:abbreviation>
    <cmns-av:explanatoryNote xml:lang="en"></cmns-av:explanatoryNote>
  </rdf:Description>
