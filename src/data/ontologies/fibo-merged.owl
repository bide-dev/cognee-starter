  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/TotalReturnLeg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/ReturnLeg"/>
    <rdfs:label xml:lang="en">total return leg</rdfs:label>
    <skos:definition xml:lang="en">return leg based on the income generated by the underlying asset as well as any appreciation, decrease in value, capital gains, and fees on any increase in value</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">This is distinguished from the more general Return Leg by the addition of increase or decrease in the value of the underlying asset.</cmns-av:explanatoryNote>
  </rdf:Description>
