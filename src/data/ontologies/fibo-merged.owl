    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/CollateralizedDebtObligations/AgencyJumpZTranche"/>
    <rdfs:label xml:lang="en">agency sticky jump z</rdfs:label>
    <skos:definition xml:lang="en">"Sticky" Jump Z tranches maintain the payment priority of a Jump Z tranche until they are retired.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/Facility-FXGB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MultilateralTradingFacility"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OperatingLevelMarket"/>
    <rdfs:label>FXCM - MTF</rdfs:label>
