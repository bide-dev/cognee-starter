  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterestRateAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider"/>
    <rdfs:subClassOf rdf:nodeID="N99b5e86a5a9449f6aec66bab10767364"/>
    <rdfs:label>interest rate authority</rdfs:label>
    <skos:definition>financial service provider/publisher responsible for specifying some benchmark interest rate</skos:definition>
    <skos:example>This is typically a bank, central bank in the case of the publication of bank interest rates, or the committee responsible for publishing interbank rates, such as EURIBOR.</skos:example>
  </rdf:Description>
