    <rdf:type rdf:nodeID="Ne5c02f3968cc47d0a107a6b2634dabd3"/>
    <rdfs:label>ACTUS contract type - convertible note</rdfs:label>
    <skos:definition>cashflow classifier that applies to bonds with a call or put option</skos:definition>
    <skos:editorialNote>Should this also only classify contracts that are convertible? Does this mean an additional restriction? Does it really apply to any sort of loan?</skos:editorialNote>
    <skos:note>If the option is exercised, the underlying bond ceases to exist.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>Callable and puttable bonds or loans.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashflowCategory-Asymmetric"/>
    <cmns-col:isMemberOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-dsg:isDefinedIn rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/AlgorithmicContractTypesClassificationScheme"/>
    <cmns-txt:hasTextValue>BNDCP</cmns-txt:hasTextValue>
  </rdf:Description>
