  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Parties Ontology</rdfs:label>
    <dcterms:abstract>This ontology extends the Commons Parties and Situations ontology with identifiers for party roles and very general tax identifiers.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.
		
