  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/MD/DebtTemporal/DebtAnalytics/DebtYieldToAverageLife">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/MD/DebtTemporal/DebtAnalytics/DebtInstrumentYield"/>
    <rdfs:subClassOf rdf:nodeID="Nf2f3af2a5585472f95f70f018b03ee81"/>
    <rdfs:label xml:lang="en">debt yield to average life</rdfs:label>
    <skos:definition xml:lang="en">The yield achieved by substituting a bond's average life for the issue's final maturity date.</skos:definition>
    <skos:editorialNote xml:lang="en">Assume from this that there is also a Yield to Equivalent Life. Some sources have these as the same term, whereas we have separated them.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityCFIClassificationIndividuals/PreferredNonVotingRedeemableExchangeableNormalIncomeRegisteredShare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/ExchangeablePreferredShare"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/NonVotingShare"/>
