    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://opensource.org/licenses/MIT</dcterms:license>
    <dcterms:title>FIBO BE Functional Entities Module</dcterms:title>
    <dcterms:title>Financial Industry Business Ontology (FIBO) Business Entities (BE) Functional Entities Module</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://spec.edmcouncil.org/fibo/"/>
