  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecurityUnderwritingArrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/UnderwritingArrangement"/>
    <rdfs:subClassOf rdf:nodeID="Ncf3c2fb1ebf84f41b925f84bf4526272"/>
    <rdfs:label>security underwriting arrangement</rdfs:label>
    <skos:definition>underwriting agreement between an organization (typically an investment bank) and a securities issuer that commits the underwriter to assuming risk involved in buying a new issue of securities and reselling it to the public</skos:definition>
    <cmns-av:adaptedFrom>Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>Sales may be made either directly or through third-party dealers.</cmns-av:explanatoryNote>
  </rdf:Description>
