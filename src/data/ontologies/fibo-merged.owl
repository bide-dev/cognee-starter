    <rdfs:subClassOf rdf:nodeID="N4fcc46e340254ff9a732f35cee3972fe"/>
    <rdfs:label xml:lang="en-US">preferred, enhanced voting, redeemable extendable, auction rate income, registered share</rdfs:label>
