  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/LatinAmericanJurisdiction/SouthAmericanGovernmentEntitiesAndJurisdictions/ChileanEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SovereignState"/>
    <rdfs:label>Chilean entity</rdfs:label>
    <skos:definition>sovereign state and polity that occupies a long, narrow strip of land between the Andes to the east and the Pacific Ocean to the west, and borders Peru to the north, Bolivia to the northeast, Argentina to the east, and the Drake Passage in the far south</skos:definition>
    <fibo-be-ge-ge:hasFullSovereigntyOver rdf:resource="https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Chile"/>
    <fibo-be-ge-ge:isRepresentedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/LatinAmericanJurisdiction/SouthAmericanGovernmentEntitiesAndJurisdictions/GovernmentOfTheRepublicOfChile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/MuniIssuance/disseminationDecisionDateAndTime">
