  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/isPrivate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">is private</rdfs:label>
    <rdfs:domain rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/Pools/PooledFund"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:definition xml:lang="en">indicates that the fund does not offer its securities to the general public</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">In the U.S., private funds are exempt from certain regulations under the Investment Company Act of 1940. Common types include venture capital funds, private equity funds, and some hedge funds. They often target illiquid assets or use aggressive strategies, offering flexibility compared to public funds.</cmns-av:explanatoryNote>
  </rdf:Description>
