    <skos:definition>jurisdiction of the Third District of the Federal Reserve, which covers eastern Pennsylvania, southern New Jersey, and Delaware</skos:definition>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.philadelphiafed.org/about-the-fed/</cmns-av:adaptedFrom>
