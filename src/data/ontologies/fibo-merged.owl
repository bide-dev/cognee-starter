  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/hasOffering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
