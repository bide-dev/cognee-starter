  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/TransactionConfirmation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/Documents/LegalDocument"/>
    <rdfs:subClassOf rdf:nodeID="N8d00d87c4826403fa15c05fc51adea7d"/>
    <rdfs:label>transaction confirmation</rdfs:label>
