  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/SecuredBond">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/Bond"/>
    <rdfs:label>secured bond</rdfs:label>
    <owl:disjointWith rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/UnsecuredBond"/>
    <skos:definition>bond that is backed by collateral, such as a tangible asset or income stream, in addition to a general promise to pay</skos:definition>
    <cmns-av:explanatoryNote>A secured bond may be collateralized by a claim on real assets, such as a factory or auto fleet; or by a claim on a revenue stream. A secured bond differs from a mortgage in that proceeds of the bond sale aren't used to acquire the asset.</cmns-av:explanatoryNote>
  </rdf:Description>
