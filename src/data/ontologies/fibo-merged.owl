  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CloseOutNettingProvision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision"/>
    <rdfs:label xml:lang="en">close-out netting provision</rdfs:label>
    <owl:disjointWith rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/SettlementNettingProvision"/>
    <skos:definition xml:lang="en">netting provision that may be triggered when a counterparty defaults, leading to the termination of all outstanding transactions between the parties</skos:definition>
    <cmns-av:explanatoryNote>In the case of close-out netting, the financial positions of the defaulting party are assessed to determine their worth, and total amounts owed are offset, resulting in a single net payment obligation.</cmns-av:explanatoryNote>
    <cmns-av:synonym>close out netting provision</cmns-av:synonym>
  </rdf:Description>
