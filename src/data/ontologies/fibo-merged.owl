  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/MD/DebtTemporal/DebtAnalytics/LifeAnalytic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
