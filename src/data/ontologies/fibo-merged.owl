  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/DispersionLeg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/PerformanceBasedVariableLeg"/>
    <rdfs:subClassOf rdf:nodeID="N4c1fad24352642eea2b65831bc033303"/>
    <rdfs:label xml:lang="en">dispersion leg</rdfs:label>
    <skos:definition>floating leg of a dispersion swap that pays an amount based on the realized dispersion of the price changes of the underlying product</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Underlying assets may include, for example, exchange rates, interest rates, or the price of an index.</cmns-av:explanatoryNote>
    <cmns-av:synonym xml:lang="en">variance leg</cmns-av:synonym>
  </rdf:Description>
