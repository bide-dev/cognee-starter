  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/MetadataFIBO/FIBOSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Module"/>
    <rdfs:label>FIBO Specification</rdfs:label>
    <dcterms:abstract>The Financial Industry Business Ontology (FIBO) is a collaborative effort among industry practitioners, semantic technology experts and information scientists to standardize the language used to precisely define the terms, conditions, and characteristics of financial instruments; the legal and relationship structure of business entities; the content and time dimensions of market data; and the legal obligations and process aspects of corporate actions. The definitions and relationships that comprise FIBO have been modularized into a number of domains, which in turn include a number of modules, each of which is further modularized into one or more constituent ontologies. 

The FIBO ontologies are available for download as OWL 2 DL compliant ontologies from the EDM Council site in three serializations: RDF/XML, Turtle, and JSON-LD, and are linked at https://spec.edmcouncil.org/fibo/ontology/. They can also be downloaded directly from GitHub at https://github.com/edmcouncil/fibo.</dcterms:abstract>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/MetadataACTUS/ACTUSDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/MetadataBE/BEDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BP/MetadataBP/BPDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/CAE/MetadataCAE/CAEDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/MetadataDER/DERDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/MetadataFBC/FBCDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/MetadataFND/FNDDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/IND/MetadataIND/INDDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/LOAN/MetadataLOAN/LOANDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/MD/MetadataMD/MDDomain"/>
    <dcterms:hasPart rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/MetadataSEC/SECDomain"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-31T18:00:00</dcterms:issued>
