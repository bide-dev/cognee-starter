  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/CommonInterestRates/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Common Interest Rates Ontology</rdfs:label>
    <dcterms:abstract>This ontology provides reference data for commonly referenced interest rates, specifically those that are referenced in the ISDA FpML codes for floating interest rates. The rates included herein are generated directly from the FpML published reference data.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2015-2025 EDM Council, Inc.
