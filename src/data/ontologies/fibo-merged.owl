  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Addresses Ontology</rdfs:label>
    <dcterms:abstract>This ontology provides high level definitions for addresses and address components including elements that are common to addressing standards.</dcterms:abstract>
    <dcterms:license>Copyright (c) 2013-2025 EDM Council, Inc.
