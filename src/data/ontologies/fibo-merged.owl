  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment"/>
    <rdfs:subClassOf rdf:nodeID="Nd590c6b7e7d14e7db0132ea82515fc90"/>
    <rdfs:subClassOf rdf:nodeID="Na2046b81760a4a58b5ccea7cf2193f2c"/>
    <rdfs:subClassOf rdf:nodeID="Nbcc0319181784ce3b42f62dc6acd29dd"/>
    <rdfs:subClassOf rdf:nodeID="N49306e43894040d3b45752e296272765"/>
    <rdfs:subClassOf rdf:nodeID="N827dc238b44e443db504f8653f1376a8"/>
    <rdfs:label>guaranty</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/"/>
    <skos:definition>commitment whereby something is formally assured if a party with primary liability fails to perform</skos:definition>
    <cmns-av:adaptedFrom>Barron's Dictionary of Business and Economics Terms, Fifth Edition, 2012</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>The commitment may cover a debt, cash flows on a debt instrument (such as interest payments), or performance of some obligation.</cmns-av:explanatoryNote>
  </rdf:Description>
