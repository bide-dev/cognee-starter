  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/MuniIssuance/IssueOverAllotmentTerms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/IssuanceDocuments/OfferingDocumentTerms"/>
    <rdfs:subClassOf rdf:nodeID="N5f025477e07b49e5ad48b87eb0a753db"/>
    <rdfs:label xml:lang="en">issue over allotment terms</rdfs:label>
    <skos:definition xml:lang="en">Terms for Change to an Issue Amount. A provision in an underwriting agreement, which allows members of the underwriting syndicate to purchase additional shares at the original price.</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Also known as a green shoe. Note that this set of terms does not refer to over-allotment as change to a the total issue amount issued to an individual investor. That would require separate but similar terms. FIBIM has "Over Allotment Amount" as an individual term.</cmns-av:explanatoryNote>
  </rdf:Description>
