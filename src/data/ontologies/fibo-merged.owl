    <rdfs:subClassOf rdf:nodeID="N295659eec69a41b5bc6290fe85ac3881"/>
    <rdfs:label>registered charity program number</rdfs:label>
    <skos:definition>concatenation of an entity's business number, the 'RR' abbreviation and a 4-digit subaccount number used for registered charity contribution</skos:definition>
    <skos:example>000000000RR0001</skos:example>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.canada.ca/en/revenue-agency/services/charities-giving/charities/operating-a-registered-charity/registration-number.html</cmns-av:adaptedFrom>
    <cmns-av:explanatoryNote>An organization may have more than one registered charity account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration.</cmns-av:explanatoryNote>
  </rdf:Description>
