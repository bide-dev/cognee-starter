    <skos:definition>proprietary identification scheme for securities identifiers managed by the London Stock Exchange Group's LSEG Financial Solutions</skos:definition>
    <cmns-av:abbreviation>RIC scheme</cmns-av:abbreviation>
    <cmns-av:adaptedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://community.developers.refinitiv.com/questions/28938/ric-code-understandingidentificaiton.html</cmns-av:adaptedFrom>
