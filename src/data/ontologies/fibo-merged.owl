    <rdfs:label xml:lang="en">make securities availabe in market</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/MD/DerivativesTemporal/ETOptionsTemporal/OptionsVega">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/MD/DerivativesTemporal/ETOptionsTemporal/OptionsGreek"/>
    <rdfs:subClassOf rdf:nodeID="N8d0b57242c284c3d902a4ba258669106"/>
    <rdfs:label xml:lang="en">options vega</rdfs:label>
    <skos:definition xml:lang="en">A measure of the rate of change in an option's theoretical value for a one-unit change in the volatility assumption. Action: add terms that define or influence this.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/CollectiveInvestmentVehicles/FundUnitDistributionPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Policy"/>
    <rdfs:subClassOf rdf:nodeID="Na7c65b4199f04c2392c1d946d8adf10b"/>
    <rdfs:label xml:lang="en">fund unit distribution policy</rdfs:label>
    <skos:definition xml:lang="en">policy relating to the unit, e.g. if income is paid out or retained in the fund and how this is treated, including distribution policy details for dividends and coupons.</skos:definition>
  </rdf:Description>
