  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CurrencyInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
