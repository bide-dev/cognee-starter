  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/ProtectivePut">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/PutOption"/>
    <rdfs:subClassOf rdf:nodeID="N8b654f2fb77c46fc84d161a37d51b22b"/>
    <rdfs:label xml:lang="en">protective put</rdfs:label>
    <skos:definition xml:lang="en">put option giving the buyer (holder) the right, but not the obligation, to sell the assets specified at with a strike price equal or close to the current price of the underlying asset, on or before a specified date</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">A protective put is a risk management and options strategy that involves holding a long position in the underlying asset (e.g., stock). A protective put strategy is analogous to the nature of insurance. The main goal of a protective put is to limit potential losses that may result from an unexpected price drop of the underlying asset</cmns-av:explanatoryNote>
    <cmns-av:synonym xml:lang="en">synthetic call</cmns-av:synonym>
  </rdf:Description>
