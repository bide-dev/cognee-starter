    <rdf:type rdf:nodeID="N2fc352732c8f480097ba734e2e6eb721"/>
    <rdfs:label>ACTUS contract type - securitization market risk</rdfs:label>
    <dcterms:source>https://www.actusfrf.org/taxonomy</dcterms:source>
    <skos:definition>cashflow classifier that applies to securitization contracts where all underlying contracts are treated equally</skos:definition>
    <skos:note>The buyer of a tranche gets a part of the cash-flows.</skos:note>
    <fibo-actus-acv:hasCoverageDescription>ABS's, MBS's of all sorts. Could be a simple tranche or more complex tranch like interest only and principal only.</fibo-actus-acv:hasCoverageDescription>
    <cmns-cls:isClassifiedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSControlledVocabulary/ACTUSCashFlowFamily-Combined"/>
