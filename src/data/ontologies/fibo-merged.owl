  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/ExoticOptions/Swaption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/ExoticOption"/>
    <rdfs:subClassOf rdf:nodeID="Ndebb3d5fb46d4dbcb9240f139fd163eb"/>
    <rdfs:label xml:lang="en">swaption</rdfs:label>
    <skos:definition xml:lang="en">over-the-counter option that confers the right but not the obligation, to enter into a swap transaction at some time in the future</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">A swaption, also known as a swap option, refers to an option to enter into an interest rate swap or some other type of swap. In exchange for an options premium, the buyer gains the right but not the obligation to enter into a specified swap agreement with the issuer on a specified future date.</cmns-av:explanatoryNote>
    <cmns-av:synonym xml:lang="en">swap option</cmns-av:synonym>
  </rdf:Description>
