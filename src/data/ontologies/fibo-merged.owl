  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Equity Instruments Ontology</rdfs:label>
    <dcterms:abstract>Core terms are those fundamental to all equity instruments. This ontology also distinguishes between privately held and publicly traded equity instruments, and defines a number of related concepts, such as voting rights.</dcterms:abstract>
