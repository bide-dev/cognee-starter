  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DistributedLoans/SyndicatedLoan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditFacility"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/CommercialLoans/CommercialLoan"/>
    <rdfs:subClassOf rdf:nodeID="N6efcce0c726946e9b35db5095926b9e8"/>
    <rdfs:label xml:lang="en">syndicated loan</rdfs:label>
    <skos:definition xml:lang="en">credit agreement in which a group of lenders, known as a syndicate, collectively provides a large loan to a single borrower</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">A syndicated loan enables pooling of funds from multiple financial institutions, typically under the leadership of one or more arranging banks. These kinds of credit agreements are often used by large corporations, private equity investors and government entities for significant capital needs such as acquisitions, project financing, or to meet operational requirements.</cmns-av:explanatoryNote>
  </rdf:Description>
