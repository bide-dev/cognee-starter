  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/isPartyControlling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
