  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DistributedLoans/LeadArranger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution"/>
    <rdfs:label xml:lang="en">lead arranger</rdfs:label>
    <skos:definition xml:lang="en">financial institution that spearheads the loan structuring and syndication process on behalf of the borrower</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">The lead arranger acts as the primary point of contact for the borrower. They perform credit analysis and due diligence, ensure that the structure meets borrowers goals, and coordinates with potential lenders regarding the initial structure and commitments.</cmns-av:explanatoryNote>
    <cmns-av:synonym xml:lang="en">arranger</cmns-av:synonym>
    <cmns-av:synonym xml:lang="en">lead bank</cmns-av:synonym>
    <cmns-av:synonym xml:lang="en">lead manager</cmns-av:synonym>
  </rdf:Description>
