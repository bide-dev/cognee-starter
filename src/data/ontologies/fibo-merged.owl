  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/LegalEntity-LIBYANSTOCKMARKET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
