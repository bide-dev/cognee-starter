    <rdfs:label xml:lang="en">combined instruments purchase right</rdfs:label>
    <skos:definition xml:lang="en">purchase right that gives a prospective acquiree's holders of multiple securities the right to buy securities of the firm or securities of anyone who acquires the firm at a deep discount to their fair market value</skos:definition>
    <cmns-av:adaptedFrom xml:lang="en">ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019</cmns-av:adaptedFrom>
  </rdf:Description>
