  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/DER/MetadataDER/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Metadata about the EDMC-FIBO Derivatives (DER) Domain</rdfs:label>
    <dcterms:abstract>The Derivatives (DER) Domain covers many of the concepts that are common to derivative instruments, including but not limited to options, futures, forwards, swaps, and a wide range of other derivatives. This ontology provides metadata about the Derivatives Domain and its contents.</dcterms:abstract>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-31T18:00:00</dcterms:issued>
    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://opensource.org/licenses/MIT</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-03T18:00:00</dcterms:modified>
