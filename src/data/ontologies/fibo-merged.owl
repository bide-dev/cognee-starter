  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/AccountingEquity/RetainedEarnings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/AccountingEquity/OwnersEquity"/>
    <rdfs:label>retained earnings</rdfs:label>
    <skos:definition>net profits kept to accumulate in a business after dividends are paid</skos:definition>
    <cmns-av:explanatoryNote>If the corporation takes a loss, then that loss is retained and called variously retained losses, accumulated losses or accumulated deficit. Retained earnings and losses are cumulative from year to year with losses offsetting earnings.</cmns-av:explanatoryNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DarkPool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem"/>
    <rdfs:label>dark pool</rdfs:label>
    <skos:definition>privately organized alternative trading system, that allows institutional investors the ability to trade without exposure until after the trade has been executed and reported</skos:definition>
  </rdf:Description>
