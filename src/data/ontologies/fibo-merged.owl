  </rdf:Description>
  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/IND/MetadataIND/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Metadata about the EDMC-FIBO Indices and Indicators (IND) Domain</rdfs:label>
    <dcterms:abstract>This ontology provides metadata about the FIBO Indices and Indicators (IND) Domain, which covers market indices and reference rates including economic indicators, foreign exchange, interest rates, and other benchmarks.</dcterms:abstract>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-08-27T18:00:00</dcterms:issued>
