    <cmns-rlcmp:isPlayedBy rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/MarketsIndividuals/LegalEntity-CHITTAGONGSTOCKEXCHANGELTD"/>
