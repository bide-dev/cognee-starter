  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FND/AllFND-NorthAmerica/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>all FND, North America</rdfs:label>
    <dcterms:abstract>The North American extension of the Foundations (FND) domain builds on the more general FND ontologies with concepts that are specific to the North American region of the world, such as those defining North American addresses.</dcterms:abstract>
    <dcterms:contributor>Adaptive, Inc.</dcterms:contributor>
    <dcterms:contributor>Anthony B. Coates</dcterms:contributor>
    <dcterms:contributor>Hypercube Limited</dcterms:contributor>
    <dcterms:contributor>John F. Gemski</dcterms:contributor>
    <dcterms:contributor>Maxwell Gillmore</dcterms:contributor>
    <dcterms:contributor>Nordea Bank AB</dcterms:contributor>
    <dcterms:contributor>Office of Financial Research (US Dept of the Treasury)</dcterms:contributor>
    <dcterms:contributor>Pinnacle Bank (Morgan Hill, California)</dcterms:contributor>
    <dcterms:contributor>State Street Bank and Trust</dcterms:contributor>
    <dcterms:contributor>Tahoe Blue Ltd</dcterms:contributor>
    <dcterms:contributor>Thematix Partners LLC</dcterms:contributor>
    <dcterms:contributor>Wells Fargo</dcterms:contributor>
    <dcterms:contributor>Working Ontologist</dcterms:contributor>
    <dcterms:contributor>agnos.ai, UK Ltd.</dcterms:contributor>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-22T18:00:00</dcterms:issued>
    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://opensource.org/licenses/MIT</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-20T18:00:00</dcterms:modified>
    <dcterms:title>FIBO FND Domain, North American Extension</dcterms:title>
    <dcterms:title>Financial Industry Business Ontology (FIBO) Foundations (FND) Domain, North American Extension</dcterms:title>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://spec.edmcouncil.org/fibo/</rdfs:seeAlso>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/AllFND/"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddresses/"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Places/NorthAmerica/USPostalServiceAddressesIndividuals/"/>
    <owl:versionIRI rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/20230101/AllFND-NorthAmerica/"/>
    <cmns-av:copyright>Copyright (c) 2017-2023 EDM Council, Inc.</cmns-av:copyright>
    <cmns-av:copyright>Copyright (c) 2017-2023 Object Management Group, Inc.</cmns-av:copyright>
    <cmns-av:explanatoryNote>The 'all' ontology for Foundations (FND), North American Extension is provided for convenience for FIBO users. This ontology does not add new assertions, but imports the Production (Released) ontologies that comprise the FIBO Foundations (FND) domain, including extensions related to postal addressing in the US and Canada.</cmns-av:explanatoryNote>
  </rdf:Description>
