    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/PreferredShareWithFixedRateDividend"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/RegisteredSecurity"/>
    <rdfs:subClassOf rdf:nodeID="Nc6834d91561449248d2e12057ee8accd"/>
    <rdfs:label xml:lang="en-US">preferred, non-voting, redeemable extendable, fixed income, registered share</rdfs:label>
    <skos:definition>preferred share that confers zero votes per share, whose issuer and/or shareholders have the option to extend the maturity date, that provides a periodic stated income, and is registered</skos:definition>
  </rdf:Description>
