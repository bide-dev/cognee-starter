  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/CAE/CorporateEvents/SecurityRelatedCorporateActions/StockSplit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/CAE/CorporateEvents/CorporateActions/MandatoryCorporateAction"/>
    <rdfs:subClassOf rdf:nodeID="Ne4be6a9055de4fcab7188fd5c8f04443"/>
    <rdfs:label xml:lang="en">stock split</rdfs:label>
    <skos:definition xml:lang="en">corporate action involving an increase in a corporation's number of outstanding equities without any change in the shareholder's equity or the aggregate market value at the time of the split</skos:definition>
    <cmns-av:explanatoryNote xml:lang="en">Equity price and nominal value are reduced accordingly.</cmns-av:explanatoryNote>
    <cmns-av:synonym xml:lang="en">change in nominal value</cmns-av:synonym>
