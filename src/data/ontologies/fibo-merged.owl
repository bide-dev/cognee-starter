    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective"/>
    <rdfs:label>not for profit objective</rdfs:label>
    <owl:disjointWith rdf:resource="https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ProfitObjective"/>
    <skos:definition>objective that reflects the charitable, educational, religious, humanitarian, public services, or other not for profit goals of an organization</skos:definition>
    <cmns-av:explanatoryNote>The objective of all business activities is not to earn profits for its owners. All of the money earned by or donated to a not for profit organization is used in pursuing the organization's objectives.</cmns-av:explanatoryNote>
    <cmns-av:synonym>nonprofit objective</cmns-av:synonym>
  </rdf:Description>
