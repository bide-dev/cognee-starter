  <rdf:Description rdf:about="https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/Documents/Record"/>
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry"/>
    <rdfs:subClassOf rdf:nodeID="N3f5afc81f4da47ca8b26eecaa565771e"/>
    <rdfs:subClassOf rdf:nodeID="N1d1820a3e1a54ffbbb811b2543760102"/>
    <rdfs:subClassOf rdf:nodeID="Nf02504d293f24ca5a2f379e54263166d"/>
    <rdfs:subClassOf rdf:nodeID="N849977b5547242beb75a65f624b964d5"/>
    <rdfs:subClassOf rdf:nodeID="Ned4f91398c224a6eb50a6d651fcc6256"/>
    <rdfs:subClassOf rdf:nodeID="Nd599624f21274da8979245082a7cb27a"/>
    <rdfs:subClassOf rdf:nodeID="Ne983c48c0b3c4fadb045d7c26d30d3cc"/>
    <rdfs:label>transaction record</rdfs:label>
    <skos:definition>record of transactions associated with an account</skos:definition>
    <cmns-av:usageNote>The date a particular transaction record is closed typically corresponds to (and may precede) the date the account is closed, though in the case of certain accounts, such as a credit card account, if a customer is issued a new account or card number due to loss, fraud, or for some other reason, it is possible that multiple transaction records would be associated with the account. In that case, the close date might correspond to the date that a hold was placed on the original account.</cmns-av:usageNote>
  </rdf:Description>
